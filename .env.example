# Set the same random service token (32+ characters) on the Express API and AI server.
AI_SERVICE_TOKEN=
# Express internal API origin, without trailing slash or path.
API_INTERNAL_URL=http://127.0.0.1:4000
# Shared key for Solar Pro 4 and Information Extract.
UPSTAGE_API_KEY=
# Optional pair, only when the backend issues Vercel private Blob references.
BLOB_PRIVATE_ORIGIN=
BLOB_READ_WRITE_TOKEN=
