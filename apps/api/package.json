{
  "name": "@agentfit/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:baseline": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script --output prisma/migrations/202610060001_initial/migration.sql",
    "db:diff": "prisma migrate diff",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@agentfit/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/blob": "2.8.0",
    "@vercel/queue": "0.7.0",
    "better-auth": "1.7.7",
    "cors": "2.8.6",
    "diff": "9.0.0",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "fflate": "0.8.3",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "smol-toml": "1.9.0"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  }
}
