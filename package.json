{
  "name": "agentfit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "evaluate:model": "tsx tools/evaluate-model.ts",
    "evaluate:quality": "tsx tools/check-extraction-quality.ts",
    "verify:configuration": "tsx tools/verify-generated-configuration.ts",
    "contracts:generate": "node tools/generate-contract-types.mjs",
    "setup:local": "node tools/local-environment.mjs",
    "db:local": "node tools/local-postgres.mjs",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts",
    "test:api": "vitest run tests/api tests/integration",
    "test:web": "vitest run tests/web",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && pnpm --filter @agentfit/web typecheck",
    "lint": "eslint .",
    "build": "pnpm --filter @agentfit/api build && pnpm --filter @agentfit/web build",
    "dev:api": "pnpm --filter @agentfit/api dev",
    "dev:ai": "node tools/run-ai.mjs",
    "dev:web": "pnpm --filter @agentfit/web dev",
    "db:up": "docker compose --env-file .env -f infra/compose.yaml up -d",
    "db:migrate": "pnpm --filter @agentfit/api db:migrate"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
