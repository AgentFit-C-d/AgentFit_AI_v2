{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentfit.local/configuration.schema.json",
  "definitions": {
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recommendationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "expectedBasis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "projectVersion": {
              "type": "integer",
              "minimum": 1
            },
            "developerVersion": {
              "type": "integer",
              "minimum": 0
            },
            "environmentVersion": {
              "type": "integer",
              "minimum": 0
            },
            "catalogRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "projectVersion",
            "developerVersion",
            "environmentVersion",
            "catalogRevision"
          ]
        },
        "selectedToolIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "permissionPolicies": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "catalogItemId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "resourceScope": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "mappingId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "policy": {
                "enum": [
                  "ASK_EACH_TIME",
                  "ALWAYS_ALLOW",
                  "DENY"
                ]
              }
            },
            "required": [
              "catalogItemId",
              "key",
              "resourceScope",
              "mappingId",
              "policy"
            ]
          }
        },
        "existingState": {
          "enum": [
            "UNKNOWN",
            "USER_SAYS_EMPTY",
            "PROVIDED"
          ]
        },
        "existingFiles": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "targetKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "relativePath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "content": {
                "type": "string",
                "maxLength": 100000
              }
            },
            "required": [
              "targetKey",
              "relativePath",
              "content"
            ]
          }
        },
        "customSkill": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])$)[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "instructions": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            }
          },
          "required": [
            "name",
            "description",
            "instructions"
          ]
        }
      },
      "required": [
        "recommendationId",
        "expectedBasis",
        "selectedToolIds",
        "permissionPolicies",
        "existingState",
        "existingFiles"
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previewId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "previewFingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "confirmation": {
          "const": true
        }
      },
      "required": [
        "previewId",
        "previewFingerprint",
        "confirmation"
      ]
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approvalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "previewId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "previewFingerprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recommendationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "expectedBasis": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "projectVersion": {
                  "type": "integer",
                  "minimum": 1
                },
                "developerVersion": {
                  "type": "integer",
                  "minimum": 0
                },
                "environmentVersion": {
                  "type": "integer",
                  "minimum": 0
                },
                "catalogRevision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "projectVersion",
                "developerVersion",
                "environmentVersion",
                "catalogRevision"
              ]
            },
            "selectedToolIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              }
            },
            "permissionPolicies": {
              "type": "array",
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "catalogItemId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "resourceScope": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "mappingId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "policy": {
                    "enum": [
                      "ASK_EACH_TIME",
                      "ALWAYS_ALLOW",
                      "DENY"
                    ]
                  }
                },
                "required": [
                  "catalogItemId",
                  "key",
                  "resourceScope",
                  "mappingId",
                  "policy"
                ]
              }
            },
            "existingState": {
              "enum": [
                "UNKNOWN",
                "USER_SAYS_EMPTY",
                "PROVIDED"
              ]
            },
            "existingFiles": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "targetKey": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "relativePath": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "content": {
                    "type": "string",
                    "maxLength": 100000
                  }
                },
                "required": [
                  "targetKey",
                  "relativePath",
                  "content"
                ]
              }
            },
            "customSkill": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])$)[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "instructions": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000
                }
              },
              "required": [
                "name",
                "description",
                "instructions"
              ]
            }
          },
          "required": [
            "recommendationId",
            "expectedBasis",
            "selectedToolIds",
            "permissionPolicies",
            "existingState",
            "existingFiles"
          ]
        }
      },
      "required": [
        "approvalId",
        "previewId",
        "previewFingerprint",
        "input"
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reportedState": {
          "enum": [
            "APPLIED",
            "FAILED"
          ]
        },
        "reasonCode": {
          "enum": [
            null,
            "COPY_FAILED",
            "AUTH_REQUIRED",
            "DEPENDENCY_MISSING",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "reportedState",
        "reasonCode"
      ]
    }
  }
}
