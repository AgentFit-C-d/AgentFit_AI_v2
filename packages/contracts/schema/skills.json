      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "leaseId"
      ],
      "properties": {
        "targetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "leaseId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        }
      }
