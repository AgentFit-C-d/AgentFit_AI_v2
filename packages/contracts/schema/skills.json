{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentfit.local/skills.json",
  "definitions": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "field",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z_]+:[0-9]{1,3}$"
        },
        "field": {
          "enum": [
            "frontend",
            "backend",
            "ai",
            "database",
            "deployment",
            "features",
            "external_integrations",
            "work",
            "purpose"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "need": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "query",
        "sourceFields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^n[1-6]$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "query": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9 -]+$"
        },
        "sourceFields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+:[0-9]{1,3}$"
          }
        }
      }
    },
    "needs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needs"
      ],
      "properties": {
        "needs": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/definitions/need"
          }
        }
      }
    },
    "needRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts",
        "deadline"
      ],
      "properties": {
        "facts": {
          "type": "array",
          "maxItems": 96,
          "items": {
            "$ref": "#/definitions/fact"
          }
        },
        "deadline": {
          "type": "string",
          "minLength": 20,
          "maxLength": 32
        },
        "budget": {
          "$ref": "#/definitions/budgetContext"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "^[A-Za-z0-9_./-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6000
        }
      }
    },
    "rankRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needs",
        "candidates",
        "deadline"
      ],
      "properties": {
        "needs": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/definitions/need"
          }
        },
        "candidates": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "$ref": "#/definitions/candidate"
          }
        },
        "deadline": {
          "type": "string",
          "minLength": 20,
          "maxLength": 32
        },
        "budget": {
          "$ref": "#/definitions/budgetContext"
        }
      }
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matches"
      ],
      "properties": {
        "matches": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidateId",
              "needIds",
              "score",
              "reason"
            ],
            "properties": {
              "candidateId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              },
              "needIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^n[1-6]$"
                }
              },
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            }
          }
        }
      }
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedVersions"
      ],
      "properties": {
        "expectedVersions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project",
            "developer",
            "environment"
          ],
          "properties": {
            "project": {
              "type": "integer",
              "minimum": 1
            },
            "developer": {
              "type": "integer",
              "minimum": 0
            },
            "environment": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
